<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <gradient
        android:angle="45"
        android:endColor="#7C3AED"
        android:startColor="#06B6D4"
        android:type="linear" />
    <stroke
        android:width="1.2dp"
        android:color="#B3FFFFFF" />
    <padding
        android:bottom="4dp"
        android:left="10dp"
        android:right="10dp"
        android:top="4dp" />
</shape>
