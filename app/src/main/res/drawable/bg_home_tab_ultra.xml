<?xml version="1.0" encoding="utf-8"?>
<!-- Ultra AI tab: dark glass with a subtle purple stroke. The tab navigates
     to the AI Hub on tap, so it is never "selected" — no state_selected branch. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/tab_glass_dark" />
    <stroke
        android:width="1dp"
        android:color="#66B388FF" />
    <corners android:radius="18dp" />
</shape>
