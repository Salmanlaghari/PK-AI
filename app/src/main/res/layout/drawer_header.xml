<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Animated Aurora 3D glass backdrop -->
    <com.salmanlaghari.pkai.ui.custom.AuroraBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.9" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Premium 3D Glass Profile Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:translationZ="24dp"
            app:cardBackgroundColor="@color/glass_bubble_background"
            app:cardCornerRadius="22dp"
            app:cardElevation="18dp"
            app:strokeColor="@color/html_glass_border_strong"
            app:strokeWidth="1dp"
            app:rippleColor="#2200F5FF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <!-- Top Row: Avatar + Name + Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Avatar with glow ring -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_drawer_profile_pic"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_person"
                    android:scaleType="centerCrop"
                    android:tint="@color/electric_blue_glow"
                    android:background="@drawable/bg_avatar_ring"
                    android:padding="2dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Circular" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- User Name -->
                    <TextView
                        android:id="@+id/tv_drawer_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PK AI User"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <!-- Email -->
                    <TextView
                        android:id="@+id/tv_drawer_user_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="user@pkai.app"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="2dp" />

                    <!-- Premium Badge -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_premium_badge"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💎"
                            android:textSize="10sp"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PREMIUM"
                            android:textColor="@color/electric_blue_glow"
                            android:textSize="10sp"
                            android:fontFamily="@font/poppins"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/glass_stroke"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp" />

            <!-- Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Chats Stat -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_stat_chats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chats"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="10sp"
                        android:fontFamily="@font/poppins" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    android:background="@color/glass_stroke" />

                <!-- AI Models Stat -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🤖"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_stat_models"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Models"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="10sp"
                        android:fontFamily="@font/poppins" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    android:background="@color/glass_stroke" />

                <!-- Studio Stat -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎨"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_stat_studio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Studio"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="10sp"
                        android:fontFamily="@font/poppins" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/glass_stroke"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="10dp" />

            <!-- Developer Credit -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Developed by Prince Laghari ❤️"
                android:textColor="@color/purple_accent"
                android:textSize="11sp"
                android:fontFamily="@font/poppins"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginBottom="4dp" />

            <!-- Marquee Text -->
            <TextView
                android:id="@+id/tv_drawer_marquee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✨ Welcome to PK AI — Premium AI Super App ✨"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:fontFamily="@font/poppins"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:freezesText="true"
                android:requiresFadingEdge="horizontal"
                android:fadingEdgeLength="16dp"
                android:gravity="center" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</FrameLayout>