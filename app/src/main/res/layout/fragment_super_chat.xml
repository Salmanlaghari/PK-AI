<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/superChatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/anim_live_wallpaper">

    <!-- ── Header (light glass) ───────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header_light_glass"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#5E35B1"
            android:contentDescription="@string/superchat_back"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_ai_hub"
            app:tint="#7B2FFD"
            android:contentDescription="@string/superchat_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#1A1A2E"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/superchat_subtitle"
                android:textColor="#7B2FFD"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/chipPkAi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pkai_badge_active"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppins"
            android:text="✨ PK AI"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_input_light_3d"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="💡"
            android:textSize="14sp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp" />

        <TextView
            android:id="@+id/btnHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_input_light_3d"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🕐"
            android:textSize="14sp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp" />

        <TextView
            android:id="@+id/chipPro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/superchat_pro"
            android:textColor="#B8860B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_input_light_3d"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp" />
    </LinearLayout>

    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#337B2FFD"
        app:layout_constraintTop_toBottomOf="@id/headerBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Body: clean full-width chat — sticker appears beside each AI reply ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSuperChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingVertical="10dp"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintBottom_toTopOf="@id/bannerAdContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_super_chat_message" />

    <!-- ── Banner Ad ──────────────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/bannerAdContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@id/inputBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Input bar (light glass + 3D buttons) ───────────────────────── -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header_light_glass"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toTopOf="@id/superChatNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnAttach"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_input_light_3d"
            android:gravity="center"
            android:text="📎"
            android:textSize="16sp"
            android:contentDescription="@string/superchat_attach" />

        <EditText
            android:id="@+id/etSuperChatInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input_light_3d"
            android:hint="@string/superchat_hint"
            android:textColorHint="#9D8DF1"
            android:textColor="#1A1A2E"
            android:maxLines="3"
            android:inputType="textCapSentences|textMultiLine"
            android:paddingHorizontal="16dp"
            android:paddingVertical="11dp"
            android:textSize="13sp"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/btnVoice"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_voice_3d"
            android:gravity="center"
            android:text="🎤"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:contentDescription="@string/superchat_voice" />

        <TextView
            android:id="@+id/btnSuperSend"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_send_3d"
            android:gravity="center"
            android:text="➤"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:contentDescription="@string/superchat_send" />
    </LinearLayout>

    <!-- Mini nav strip (visual, mirrors reference) -->
    <LinearLayout
        android:id="@+id/superChatNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/navBackToChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/superchat_nav_chat"
            android:textColor="#5E35B1"
            android:textStyle="bold"
            android:textSize="11sp"
            android:paddingHorizontal="16dp"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
