<?xml version="1.0" encoding="utf-8"?>
<!-- Free AI tab: light blue → deep blue gradient when selected,
     dark glass with a subtle cyan stroke when idle. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="@color/tab_free_start"
                android:endColor="@color/tab_free_end"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#CC4FC3F7" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tab_glass_dark" />
            <stroke
                android:width="1dp"
                android:color="#664FC3F7" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
