<?xml version="1.0" encoding="utf-8"?>
<!-- Premium tab — HERO card: deep amber → deep purple gradient when selected
     (start is premium_amber_dark at 7.3:1 vs white so the label stays
     readable), dark glass with a subtle gold stroke when idle.
     state_selected is toggled by HomeFragment.updateTabSelection()
     (parent wires setSelected). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="@color/premium_amber_dark"
                android:centerColor="@color/purple_deep"
                android:endColor="@color/premium_deep_purple"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#CCFFD54F" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tab_glass_dark" />
            <stroke
                android:width="1dp"
                android:color="#66FFD54F" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
