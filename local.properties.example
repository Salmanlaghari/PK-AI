# ─────────────────────────────────────────────────────────────────────────────
# PK AI — local.properties.example
#
# Copy this file to `local.properties` (which is gitignored) and fill in your
# free-tier API keys. The keys are injected into BuildConfig at build time and
# are NEVER committed to the repository.
#
# Each provider below is free-tier / has a free quota:
#   • Groq            https://console.groq.com/keys
#   • LLM7.io         https://llm7.io  (no key required for most models, leave blank if unused)
#   • Mistral AI      https://console.mistral.ai/
#   • Cohere          https://dashboard.cohere.com/api-keys
#
# Image generation needs NO key — PK AI uses Pollinations' key-less endpoint.
# ─────────────────────────────────────────────────────────────────────────────

GROQ_API_KEY=your_groq_api_key_here
LLM7_API_KEY=your_llm7_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# Signing (release builds only — not required for debug)
KEYSTORE_PASSWORD=
