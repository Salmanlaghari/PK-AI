<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/anim_live_wallpaper">

    <!-- Aurora Animated Background (hidden — light live wallpaper is the background now) -->
    <com.salmanlaghari.pkai.ui.custom.AuroraBackgroundView
        android:id="@+id/aurora_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ═══ Header (light glass) ═══ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_header"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_header_light_glass"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Menu Button -->
        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Open Navigation Drawer"
            android:padding="10dp"
            android:src="@drawable/ic_menu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/html_cyan" />

        <!-- Center Title -->
        <LinearLayout
            android:id="@+id/layout_center_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/spacer_balance"
            app:layout_constraintStart_toEndOf="@id/btn_menu"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_pkai_logo" />

                <TextView
                    android:id="@+id/tv_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="PK AI"
                    android:textColor="#1A1A2E"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="AI Super App"
                android:textColor="@color/html_cyan"
                android:textSize="9sp"
                android:shadowColor="@color/html_cyan"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6" />
        </LinearLayout>

        <!-- Balance spacer: invisible twin of the menu button so the centered
             title stays truly centered (Task 3: header keeps menu + title only) -->
        <View
            android:id="@+id/spacer_balance"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══ Chat Mode Tabs — REMOVED (Task 2): provider switching moved to the
         navigation drawer "AI Mode" group (nav_mode_premium / nav_mode_free).
         Super / Ultra AI 4 pills are gone too — those screens already live in
         the drawer (nav_super_chat, nav_ultra_ai). ═══ -->

    <!-- ═══ Free AI Model Selector (visible only in Free AI mode) ═══ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_free_model_selector"
        style="@style/PkAi.GlassCard.Elevated"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="2dp"
        android:visibility="gone"
        app:cardCornerRadius="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:letterSpacing="0.08"
                android:text="@string/lbl_free_model"
                android:textColor="@color/electric_blue_glow"
                android:textSize="10sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_free_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:selectionRequired="true"
                app:singleLine="false"
                app:singleSelection="true" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ═══ Chat Messages ═══ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat_messages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/layout_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_free_model_selector" />

    <!-- ═══ Input Area (light glass) ═══ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_light_glass"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Attachment preview (above the input row) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layout_attachment_preview"
            style="@style/PkAi.GlassCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/container_attachment_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Chat / Image mode toggle — compact icon buttons -->
        <LinearLayout
            android:id="@+id/layout_image_mode_toggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            app:layout_constraintBottom_toTopOf="@id/input_message_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_attachment_preview">

            <!-- Chat mode (small icon) -->
            <ImageButton
                android:id="@+id/btn_tab_chat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_mode_button_chat_active"
                android:contentDescription="Chat mode"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_hd_chat_circle" />

            <!-- Image generation mode (small icon) -->
            <ImageButton
                android:id="@+id/btn_tab_image"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_mode_button_inactive"
                android:contentDescription="Image generation mode"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_hd_image_circle" />
        </LinearLayout>

        <!-- Attachment FAB (left) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_attach"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:contentDescription="Attach file"
            app:backgroundTint="@color/glass_surface"
            app:fabSize="mini"
            app:layout_constraintBottom_toBottomOf="@id/input_message_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/input_message_layout"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Circular"
            app:srcCompat="@drawable/ic_attach"
            app:tint="@color/html_cyan" />

        <!-- Input Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_message_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:boxBackgroundColor="@color/surfaceContainerHigh"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusTopStart="28dp"
            app:boxStrokeColor="@color/home_input_stroke"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="1.5dp"
            app:hintTextColor="@color/home_hint_focused"
            app:layout_constraintBottom_toTopOf="@id/chip_active_provider"
            app:layout_constraintEnd_toStartOf="@id/btn_voice"
            app:layout_constraintStart_toEndOf="@id/btn_attach"
            app:layout_constraintTop_toBottomOf="@id/layout_image_mode_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_message_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:hint="Ask anything…"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:textColor="@color/home_input_text"
                android:textColorHint="@color/home_hint" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Voice input button (compact, inline beside the input) -->
        <ImageButton
            android:id="@+id/btn_voice"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voice input"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_mic"
            app:layout_constraintBottom_toBottomOf="@id/input_message_layout"
            app:layout_constraintEnd_toStartOf="@id/btn_send"
            app:layout_constraintStart_toEndOf="@id/input_message_layout"
            app:layout_constraintTop_toTopOf="@id/input_message_layout"
            app:tint="@color/html_cyan" />

        <!-- Send FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Send Message"
            app:backgroundTint="@color/primary"
            app:fabSize="normal"
            app:layout_constraintBottom_toBottomOf="@id/input_message_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/input_message_layout"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Circular"
            app:srcCompat="@drawable/ic_send"
            app:tint="@color/white" />

        <!-- Active provider chip (persistent indicator, also toggles web search) -->
        <TextView
            android:id="@+id/chip_active_provider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_pill_chip_selected"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppins"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="⚡ Groq"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/input_message_layout" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
