<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="5dp">

    <!-- ── User row ───────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/userRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start">

        <TextView
            android:id="@+id/avUser"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_superchat_side_button"
            android:gravity="center"
            android:text="👤"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/superchat_user_label"
                android:textColor="#C4B5FD"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvUserMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_superchat_user_bubble"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                tools:text="Hello" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── AI row ─────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/aiRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <!-- Mood sticker shown beside every AI reply — stays visible in history -->
        <ImageView
            android:id="@+id/ivAiSticker"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/superchat_avatar"
            tools:src="@drawable/bg_superchat_ring" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAiName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/superchat_ai_label"
                android:textColor="#9D4EDD"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_superchat_ai_bubble"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp">

                <TextView
                    android:id="@+id/tvAiMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    tools:text="Hello! 👋 How are you?" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnSpeak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="12dp"
                        android:text="🔊"
                        android:textSize="12sp"
                        android:contentDescription="@string/superchat_speak" />

                    <TextView
                        android:id="@+id/btnCopy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="12dp"
                        android:text="📋"
                        android:textSize="12sp"
                        android:contentDescription="@string/superchat_copy" />

                    <TextView
                        android:id="@+id/btnFav"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="12dp"
                        android:text="💜"
                        android:textSize="12sp"
                        android:contentDescription="@string/superchat_favorite" />

                    <TextView
                        android:id="@+id/btnShare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↗️"
                        android:textSize="12sp"
                        android:contentDescription="@string/superchat_share" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
