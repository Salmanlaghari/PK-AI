<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0A0612"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvStickerPickerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/superchat_pick_sticker"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/superchat_sheet_missing"
        android:textColor="#C4B5FD"
        android:textSize="10sp"
        android:layout_marginBottom="8dp" />

    <!-- SUPER pack header — visible only when unlocked via Tips 18+ code -->
    <TextView
        android:id="@+id/tvSuperHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ai_3d_card"
        android:gravity="center"
        android:paddingVertical="8dp"
        android:layout_marginBottom="8dp"
        android:text="⚡ SUPER STICKERS ⚡"
        android:textColor="#FFD166"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStickerGrid"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="3"
        tools:listitem="@layout/item_sticker" />
</LinearLayout>
