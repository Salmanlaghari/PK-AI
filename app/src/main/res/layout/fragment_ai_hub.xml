<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/premium_black">

    <!--
      FlowMusic Engine WebView (persistent real session + automation executor).
      It is FULL-SIZE so the Flow Music SPA lays out its real mobile UI (needed for
      DOM automation), but it sits BEHIND the opaque Ultra AI chat WebView so the
      user never sees it. Declared first => drawn underneath.
    -->
    <WebView
        android:id="@+id/webview_flowmusic_backend"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Ultra AI 4 Fullscreen Mobile Web View (FRONTEND UI) - opaque, covers the engine -->
    <WebView
        android:id="@+id/webview_ultra_ai"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Flow Music Producer Studio Embedded Container (Shown when user clicks Connect or sends music prompt) -->
    <FrameLayout
        android:id="@+id/container_flowmusic_signup"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#0d1117"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0d1117"
            android:orientation="vertical">

            <!-- Clean Top Bar with Studio Title and Close button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="#161b22"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="Flow Music Producer Studio"
                    android:textColor="#F8FAFC"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_close_flowmusic_signup"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close Flow Music Studio"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#94A3B8" />
            </RelativeLayout>

            <!-- Flow Music Studio WebView -->
            <WebView
                android:id="@+id/webview_flowmusic_signup"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#0d1117" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
