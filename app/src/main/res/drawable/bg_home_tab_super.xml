<?xml version="1.0" encoding="utf-8"?>
<!-- Super tab: dark glass with a subtle pink stroke. The tab navigates to
     Super Chat on tap, so it is never "selected" — no state_selected branch. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/tab_glass_dark" />
    <stroke
        android:width="1dp"
        android:color="#66FF80AB" />
    <corners android:radius="18dp" />
</shape>
