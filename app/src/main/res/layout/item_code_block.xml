<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#0D111A"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:strokeColor="#2A2F45"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Code Block Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#161B2A"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tv_code_lang"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins"
                android:text="PYTHON"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy_code"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:text="Copy"
                android:textColor="#A0AEC0"
                android:textSize="11sp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_run_code"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:backgroundTint="#7C4DFF"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:text="▶ Run Code"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Monospaced Code Box -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#090C15"
            android:fillViewport="true"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_code_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:text="print('Hello World')"
                android:textColor="#E2E8F0"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </HorizontalScrollView>

        <!-- Loading View (Shown while running code) -->
        <LinearLayout
            android:id="@+id/layout_run_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#121624"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:indeterminateTint="#00E5FF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="Compiling &amp; Running code on HackerEarth..."
                android:textColor="#A0AEC0"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Output / Error Panel -->
        <LinearLayout
            android:id="@+id/layout_run_output_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0D111A"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <!-- Output Header Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tv_output_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#103828"
                    android:fontFamily="@font/poppins"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="✓ ACCEPTED"
                    android:textColor="#00E676"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_output_metrics"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins"
                    android:gravity="end"
                    android:text="Time: 0.02s | Memory: 2 KB"
                    android:textColor="#8892B0"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- stdout / output details -->
            <TextView
                android:id="@+id/tv_stdout_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="OUTPUT (stdout):"
                android:textColor="#8892B0"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_output_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#050811"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:text="Hello HackerEarth!"
                android:textColor="#00E5FF"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <!-- Compile / Runtime Error Section -->
            <LinearLayout
                android:id="@+id/layout_error_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_stderr_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="COMPILE / RUNTIME ERROR:"
                    android:textColor="#FF5252"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_error_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#260C14"
                    android:fontFamily="monospace"
                    android:padding="10dp"
                    android:text="SyntaxError: invalid syntax"
                    android:textColor="#FF8A80"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Quota info / Warning message -->
            <TextView
                android:id="@+id/tv_quota_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/poppins"
                android:text="Daily Free Quota: 998/1000 remaining"
                android:textColor="#718096"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
