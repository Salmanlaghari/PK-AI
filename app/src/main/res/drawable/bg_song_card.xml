<?xml version="1.0" encoding="utf-8"?>
<!-- Premium gradient card background for rich song result cards in chat. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#2E1B4D"
        android:endColor="#1A0F2E"
        android:angle="135" />
    <stroke
        android:width="1dp"
        android:color="#7B2FFD" />
    <corners android:radius="16dp" />
</shape>
