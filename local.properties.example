# ─────────────────────────────────────────────────────────────────────────────
# PK AI — local.properties.example
#
# Copy this file to `local.properties` (which is gitignored) and fill in your
# free-tier API keys. The keys are injected into BuildConfig at build time and
# are NEVER committed to the repository.
#
# Each provider below is free-tier / has a free quota:
#   • Groq            https://console.groq.com/keys
#   • Cloudflare      https://dash.cloudflare.com/profile/api-tokens  (Account ID from dashboard)
#   • LLM7.io         https://llm7.io  (no key required for most models, leave blank if unused)
#   • Mistral AI      https://console.mistral.ai/
#   • Cohere          https://dashboard.cohere.com/api-keys
#   • Cerebras        https://cloud.cerebras.ai/
#   • Hugging Face    https://huggingface.co/settings/tokens
# ─────────────────────────────────────────────────────────────────────────────

GROQ_API_KEY=your_groq_api_key_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
LLM7_API_KEY=your_llm7_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Signing (release builds only — not required for debug)
KEYSTORE_PASSWORD=
