<?xml version="1.0" encoding="utf-8"?>
<!--
    Contextual tips — compact single-line format per Prince's feedback.
    Shows occasionally as a small line, not a big banner.
    Inflated and managed by TipsHighlightBanner; NOT added to any fragment layout.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bannerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#CC1A1A2E"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💡"
        android:textSize="12sp"
        android:layout_marginEnd="6dp" />

    <TextView
        android:id="@+id/tvTipsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#FFC857"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/ivTipsClose"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:padding="4dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#FFC857"
        android:contentDescription="Close tips" />

    <!-- Hidden container for backward compat — tips now show as single line -->
    <LinearLayout
        android:id="@+id/llTipsContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:orientation="vertical" />
</LinearLayout>
