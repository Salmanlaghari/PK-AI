<?xml version="1.0" encoding="utf-8"?>
<!-- Ultra AI tab: violet → deep indigo gradient when selected,
     dark glass with a subtle purple stroke when idle. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="@color/tab_ultra_start"
                android:endColor="@color/tab_ultra_end"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#CCB388FF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tab_glass_dark" />
            <stroke
                android:width="1dp"
                android:color="#66B388FF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
