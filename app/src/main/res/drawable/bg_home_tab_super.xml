<?xml version="1.0" encoding="utf-8"?>
<!-- Super tab: pink → deep magenta gradient when selected,
     dark glass with a subtle pink stroke when idle. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="@color/tab_super_start"
                android:endColor="@color/tab_super_end"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#CCFF80AB" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tab_glass_dark" />
            <stroke
                android:width="1dp"
                android:color="#66FF80AB" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
