    <!-- ═══════════════════════════════════════════════════════════════
         M3 Shape System — Consistent rounded corners
         ═══════════════════════════════════════════════════════════════ -->

    <style name="PkAi.Shape.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="PkAi.Shape.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="PkAi.Shape.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Circular shape overlay -->
    <style name="ShapeAppearanceOverlay.App.Circular" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════
         Component Style Overlays
         ═══════════════════════════════════════════════════════════════ -->

    <!-- Glass Card Style -->
    <style name="PkAi.GlassCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/glass_background</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Elevated Glass Card -->
    <style name="PkAi.GlassCard.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/glass_elevated</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <!-- Chat Bubble Styles -->
    <style name="PkAi.Bubble.User" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="PkAi.Bubble.AI" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/ai_bubble_bg</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeColor">@color/ai_bubble_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

</resources>
