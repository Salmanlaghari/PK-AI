<?xml version="1.0" encoding="utf-8"?>
<!-- Premium tab — HERO card: gold/amber → deep purple gradient when selected,
     dark glass with a subtle gold stroke when idle. state_selected is toggled
     by HomeFragment.updateTabSelection() (parent wires setSelected). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="@color/premium_amber"
                android:centerColor="@color/purple_deep"
                android:endColor="@color/premium_deep_purple"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#CCFFD54F" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tab_glass_dark" />
            <stroke
                android:width="1dp"
                android:color="#66FFD54F" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
