<?xml version="1.0" encoding="utf-8"?>
<!-- Selected-pill (hero): gold/amber → deep purple diagonal gradient with a
     soft gold glow stroke. Used by HomeFragment.updateTabSelection() for the
     active Premium/Free tab and by the persistent active-provider chip. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="45"
        android:startColor="@color/premium_amber"
        android:centerColor="@color/purple_deep"
        android:endColor="@color/premium_deep_purple"
        android:type="linear" />
    <stroke
        android:width="1.5dp"
        android:color="#CCFFD54F" />
    <corners android:radius="20dp" />
</shape>
